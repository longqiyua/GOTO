<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 返回"
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用统计"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ═══ 概览卡片 ═══ -->
        <LinearLayout
            android:id="@+id/overviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:translationZ="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="概览"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="1.2"
                android:layout_marginBottom="10dp" />

            <!-- Row1: 使用天数 / 搜索次数 / 打开次数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/search_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用天数"
                        android:textSize="9sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.5"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/statDaysUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/search_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="搜索次数"
                        android:textSize="9sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.5"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/statSearchCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/search_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打开次数"
                        android:textSize="9sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.5"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/statOpenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

            </LinearLayout>

            <!-- Row2: 使用时长 / 累计字符 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/search_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用时长"
                        android:textSize="9sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.5"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/statUsageTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/search_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="累计字符"
                        android:textSize="9sp"
                        android:textColor="@color/text_tertiary"
                        android:textStyle="bold"
                        android:letterSpacing="0.5"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/statCharsTyped"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ═══ Top 5 排名卡片 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:translationZ="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用启动排名"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/top5Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnShowAll"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/search_bg"
                android:gravity="center"
                android:text="查看全部排名"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- ═══ 全部排名卡片（默认隐藏） ═══ -->
        <LinearLayout
            android:id="@+id/allRankCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:translationZ="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部排名"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/allRankContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
