<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏：搜索框 + 圆形详情按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/goto_screen_edge"
        android:paddingEnd="@dimen/goto_screen_edge"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:background="@color/bg_primary"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:hint="搜索应用名称或拼音..."
            android:inputType="text"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14.5sp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <!-- 圆形详情按钮：点击进入设置，长按弹出模式切换 -->
        <TextView
            android:id="@+id/btnDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@drawable/detail_btn_bg"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- 授权校验提示栏 -->
    <TextView
        android:id="@+id/licenseCheckBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary"
        android:background="@color/bg_secondary"
        android:visibility="gone" />

    <!-- 破解提示：仅机器码不匹配时显示，极不显眼 -->
    <TextView
        android:id="@+id/pirateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="请激活"
        android:textSize="10sp"
        android:textColor="#60AAAAAA"
        android:visibility="gone" />

    <!-- 会员名牌栏 -->
    <LinearLayout
        android:id="@+id/memberBadgeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/gold_light"
        android:visibility="gone">

        <!-- 品牌文字 + 会员编号 拆分为两个 TextView，便于分别设置字体 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memberBadgeBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SuperGOTO "
                android:textSize="13sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memberBadgeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="U00001"
                android:textSize="13sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/memberDeviceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0天"
            android:textSize="11sp"
            android:textColor="@color/gold_dark" />

    </LinearLayout>

    <!-- 搜索耗时 -->
    <TextView
        android:id="@+id/searchTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <!-- ═══ 智能预测栏（软稳定机制：3时段+2全天）═══ -->
    <LinearLayout
        android:id="@+id/predictionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_secondary"
        android:visibility="gone">

        <!-- 预测栏标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="猜你想用"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 时段标签 -->
            <TextView
                android:id="@+id/timeSlotLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晚间时段"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:background="@drawable/tag_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- 5个预测槽位 -->
        <LinearLayout
            android:id="@+id/predictionSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 槽位1：时段高频 -->
            <LinearLayout
                android:id="@+id/slot1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/frosted_tag_bg">

                <ImageView
                    android:id="@+id/slot1Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/slot1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 槽位2：时段高频 -->
            <LinearLayout
                android:id="@+id/slot2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/frosted_tag_bg">

                <ImageView
                    android:id="@+id/slot2Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/slot2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 槽位3：时段高频 -->
            <LinearLayout
                android:id="@+id/slot3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/frosted_tag_bg">

                <ImageView
                    android:id="@+id/slot3Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/slot3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- 槽位4：全天高频（软稳定） -->
            <LinearLayout
                android:id="@+id/slot4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/frosted_tag_bg">

                <ImageView
                    android:id="@+id/slot4Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/slot4Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 槽位5：全天高频（软稳定） -->
            <LinearLayout
                android:id="@+id/slot5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/frosted_tag_bg">

                <ImageView
                    android:id="@+id/slot5Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/slot5Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 提示文本 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:textSize="14sp"
        android:textColor="@color/text_tertiary"
        android:textIsSelectable="true"
        android:visibility="visible" />

    <!-- 加载中 -->
    <ProgressBar
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="64dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- 搜索结果列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/goto_screen_edge"
        android:paddingEnd="@dimen/goto_screen_edge"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:layoutAnimation="@anim/recycler_slide_in"
        android:visibility="gone" />

    <!-- 空结果 -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未找到匹配的应用"
            android:textSize="16sp"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="试试输入拼音首字母"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary" />

    </LinearLayout>

    <!-- ═══ 高频应用统计栏（搜索框下方索引栏）═══ -->
    <LinearLayout
        android:id="@+id/hotAppsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg_secondary"
        android:visibility="gone">

        <!-- 标题栏：高频应用 + 时效切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高频应用"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 时效切换按钮 -->
            <TextView
                android:id="@+id/hotAppsDurationBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1小时"
                android:textSize="10sp"
                android:textColor="@color/accent"
                android:background="@drawable/tag_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- 高频应用横向滚动列表 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/hotAppsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- ═══ 底部区域：快速启动槽 + 文件夹（动态添加）═══ -->
    <!-- 由代码动态添加 quickLaunchGrid 和 folderView -->

    </LinearLayout>

    <!-- 测试按钮：返回欢迎界面 -->
    <TextView
        android:id="@+id/btnTestWelcome"
        android:layout_width="40dp"
        android:layout_height="80dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="-30dp"
        android:background="#444444"
        android:text="←"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:rotation="90"
        android:elevation="4dp" />

</RelativeLayout>
