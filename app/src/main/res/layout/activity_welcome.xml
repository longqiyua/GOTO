<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/welcomeContainer"
        android:layout_width="412dp"
        android:layout_height="915dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/phone_frame_bg"
        android:elevation="8dp"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="120dp">

                <TextView
                    android:id="@+id/welcomeLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="你好,"
                    android:textSize="48sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/welcomeLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请选择你的语言"
                    android:textSize="24sp"
                    android:textColor="#888888"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-light" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="2dp"
                    android:background="#C14444"
                    android:layout_marginTop="24dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="60dp"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/btnChinese"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="中文"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="#222222"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnEnglish"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="English"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="#222222"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <View
                android:id="@+id/glowEffect"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="top|end"
                android:background="@drawable/glow_gradient"
                android:alpha="0.6"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:translationZ="1dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>