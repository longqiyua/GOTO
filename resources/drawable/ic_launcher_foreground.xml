<?xml version="1.0" encoding="utf-8"?>
<!-- 应用图标前景层（矢量 drawable） -->
<!-- 设计：白色圆角方形背景 + "goto" 文字 + 底部彩色横条 + SuperGOTO 文字 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 白色圆角方形背景 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,0 L81,0 C95.4,0 107,11.6 107,26 L107,82 C107,96.4 95.4,108 81,108 L27,108 C12.6,108 1,96.4 1,82 L1,26 C1,11.6 12.6,0 27,0 Z" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  "goto" 文字（path 近似绘制）                          -->
    <!--  g = 深色 #1A1A1A, o = 灰色 #808080, t = 深色 #1A1A1A -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- "g" 字母：圆形主体 + 右侧竖钩 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M24,38 C24,31.4 29.4,26 36,26 C42.6,26 48,31.4 48,38 C48,44.6 42.6,50 36,50 L32,50 L32,62 C32,64.2 33.8,66 36,66 L40,66 L40,70 L36,70 C31.6,70 28,66.4 28,62 L28,38 Z M36,30 C31.6,30 28,33.6 28,38 L28,46 L36,46 C40.4,46 44,42.4 44,38 C44,33.6 40.4,30 36,30 Z" />

    <!-- 第一个 "o"：灰色圆环 -->
    <path
        android:fillColor="#808080"
        android:pathData="M54,38 C54,31.4 59.4,26 66,26 C72.6,26 78,31.4 78,38 C78,44.6 72.6,50 66,50 C59.4,50 54,44.6 54,38 Z M66,30 C61.6,30 58,33.6 58,38 C58,42.4 61.6,46 66,46 C70.4,46 74,42.4 74,38 C74,33.6 70.4,30 66,30 Z" />

    <!-- "t" 字母：横杠 + 竖线 -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M84,24 L94,24 L94,28 L90,28 L90,70 L86,70 L86,28 L84,28 Z" />

    <!-- 第二个 "o"：灰色圆环（右移，注意保持在安全区域内） -->
    <path
        android:fillColor="#808080"
        android:pathData="M66,38 C66,31.4 71.4,26 78,26 C84.6,26 90,31.4 90,38 C90,44.6 84.6,50 78,50 C71.4,50 66,44.6 66,38 Z M78,30 C73.6,30 70,33.6 70,38 C70,42.4 73.6,46 78,46 C82.4,46 86,42.4 86,38 C86,33.6 82.4,30 78,30 Z" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  底部横条（颜色引用 accent，会员时通过代码 tint 切换） -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <path
        android:fillColor="@color/accent"
        android:pathData="M18,78 L90,78 L90,88 L18,88 Z" />

    <!-- 横条上 "SuperGOTO" 白色文字区域（简化为半透明白色矩形） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M26,80 L82,80 L82,86 L26,86 Z" />

</vector>
